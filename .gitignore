# ==========================================
# Trivium Academy - .gitignore
# ==========================================

# Ambientes e Segredos (CRÍTICO)
.env
.env.*
*.env
**/.env
**/.env.*
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local
settings.json
**/settings.json
backend/storage/settings.json
storage/settings.json
*.json.bak
*.bak

# Ambientes Virtuais Python
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/

# Caches e Compilações Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Dependências e Builds do Frontend (Node / Next.js)
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
backend/storage/*.log
storage/*.log

# Banco de Dados Local SQLite e Caches
*.db
*.db-shm
*.db-wal
trivium.db
backend/trivium.db
storage/trivium.db

# Configurações com Chaves de API Locais (CRÍTICO)
backend/storage/settings.json
storage/settings.json
*.json.bak

# Armazenamento de Arquivos Locais Gerados (Imagens de Lições, PDFs e Uploads)
storage/images/*.jpg
storage/images/*.png
storage/pdfs/*.pdf
backend/storage/images/*
backend/storage/pdfs/*
backend/storage/test_pdfs/*
backend/storage/uploads/*
backend/storage/documents/*
!storage/images/.gitkeep
!storage/pdfs/.gitkeep
!backend/storage/images/.gitkeep
!backend/storage/pdfs/.gitkeep
!backend/storage/uploads/.gitkeep
!backend/storage/documents/.gitkeep

# Arquivos Temporários de Rascunho / Testes Locais
scratch/
backend/scratch*
backend/test_failfast_*
backend/benchmark_test_*
backend/course*.txt
backend/hitch_*.txt
backend/hiphop_*.txt
backend/dossier_course*.txt
backend/lesson_*_content.txt
backend/new_course*.txt
backend/old_course*.txt
backend/test_writer_*.txt
backend/test_output.pdf
sample_page_*.png
Ebook_*.pdf

# Arquivos de Build de Desktop e Binários
build_desktop/
dist_desktop/
*.exe
*.spec
*.spec.bak
apostilas/
generate_report.py

# Sistema Operacional e IDEs
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
